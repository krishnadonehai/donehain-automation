# Copy to the ST VPS (e.g. /etc/donehai-st/candidate.profile) after Phase 0 discovery.
# Do not commit real paths or credentials. ST_CANDIDATE_PROFILE must point at this file.

ST_LIVE_COMPOSE_PROJECT="deployment"
ST_LIVE_PROTECTED_VOLUMES="deployment_db-data,deployment_redis-data"

ST_LIVE_WEB_PORT="8080"
ST_LIVE_API_PORT="3001"
ST_LIVE_SERVER_PORT="3000"

# Placeholder for the isolation guard; `deploy` always uses a unique
# donehai-candidate-<short_sha>-<run_id> project (fresh, project-scoped volumes).
ST_CANDIDATE_COMPOSE_PROJECT="donehai-candidate-CHANGE_ME"
ST_CANDIDATE_WEB_PORT="18080"
ST_CANDIDATE_API_PORT="13001"          # gateway (exported as CANDIDATE_GATEWAY_PORT)
ST_CANDIDATE_SERVER_PORT="13000"
ST_CANDIDATE_NOTIFICATION_PORT="13012"
ST_CANDIDATE_KNOWLEDGE_PORT="13003"
# Only if Playwright reaches the candidate through a proxy host (baked into the web build):
# ST_CANDIDATE_FRONTEND_URL="http://127.0.0.1:18080"
# ST_CANDIDATE_VITE_API_BASE_URL="http://127.0.0.1:13001/api"

ST_CANDIDATE_USE_LIVE_DATABASE="0"
ST_CANDIDATE_USE_LIVE_REDIS="0"
ST_CANDIDATE_USE_LIVE_KAFKA="0"

# The candidate compose project runs its own postgres ("database") and redis services on a
# project-scoped network. These describe them for the isolation guard; they are not exported.
ST_CANDIDATE_DATABASE_URL="postgresql://saas_app_user@database:5432/saas_platform_db"
ST_CANDIDATE_REDIS_URL="redis://redis:6379"
ST_CANDIDATE_KAFKA_CONSUMER_GROUP_PREFIX="candidate-st"

# External side effects must be disabled for the candidate stack (app env / compose overrides).
ST_CANDIDATE_SIDE_EFFECTS_SUPPRESSED="1"

# Migrations are applied MANUALLY on ST and production. The pipeline never runs migrations,
# seeds, schema dumps or Local.sql; both flags must stay 0 (the isolation guard enforces it).
ST_CANDIDATE_MIGRATIONS_ALLOWED="0"
ST_CANDIDATE_DB_SEED_ONLY="0"

# Manually migrated candidate baseline volume (DoneHai-Feature deployment/st-ci/CANDIDATE_DATABASE.md,
# "Manual prerequisite"). Must carry label com.donehai.candidate-db-baseline=true; it is copied
# read-only into each run's own volume and never modified or removed. Empty => bootstrap-only
# candidate DB, and deploy stops at the schema gate (status=not_migrated) before E2E.
ST_CANDIDATE_DB_BASELINE_VOLUME="donehai-candidate-db-baseline"

# Manifest directory: must persist across jobs and be writable by the runner user.
# Default: ${XDG_STATE_HOME:-$HOME/.local/state}/donehai-st/deployments
# ST_DEPLOY_STATE_DIR="/home/<runner-user>/.local/state/donehai-st/deployments"

# App repository on VPS (from discover.sh LIVE REPOSITORY). Builds use a detached worktree
# at the exact requested SHA; the live checkout is never switched.
ST_APP_REPO_DIR="/path/to/DoneHai-Feature"
# Standalone candidate stack (no container_name, project-scoped volumes). Never the live file.
ST_APP_CANDIDATE_COMPOSE_FILE="deployment/docker-compose.st-candidate.yml"
# Optional private env file (template: deployment/st-ci/env.candidate.example in the app repo).
# Keep FIXED_OTP_EMAIL with all fixed-OTP accounts (test1..test5@donehai.com).
ST_APP_CANDIDATE_ENV_FILE=""

ST_CANDIDATE_WAIT_TIMEOUT="2700"

# Active ST stack identifier for rollback (container or compose project name prefix).
ST_ACTIVE_STACK_LABEL="deployment"
