# Synthetic profile for isolation-guard --self-test (no Docker required for most checks).
ST_LIVE_COMPOSE_PROJECT="deployment"
ST_CANDIDATE_COMPOSE_PROJECT="donehai-candidate-deadbeef"
ST_LIVE_PROTECTED_VOLUMES="deployment_db-data,deployment_redis-data"
ST_LIVE_WEB_PORT="8080"
ST_LIVE_API_PORT="3001"
ST_LIVE_SERVER_PORT="3000"
ST_CANDIDATE_WEB_PORT="18080"
ST_CANDIDATE_API_PORT="13001"
ST_CANDIDATE_SERVER_PORT="13000"
ST_CANDIDATE_USE_LIVE_DATABASE="0"
ST_CANDIDATE_USE_LIVE_REDIS="0"
ST_CANDIDATE_USE_LIVE_KAFKA="0"
ST_CANDIDATE_DATABASE_URL="postgresql://candidate:candidate@candidate-postgres:5432/candidate_test"
ST_CANDIDATE_REDIS_URL="redis://candidate-redis:6379/0"
ST_CANDIDATE_KAFKA_CONSUMER_GROUP_PREFIX="candidate-deadbeef"
ST_CANDIDATE_SIDE_EFFECTS_SUPPRESSED="1"
ST_CANDIDATE_MIGRATIONS_ALLOWED="1"
